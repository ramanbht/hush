{
  "name": "hush",
  "version": "0.1.0",
  "private": true,
  "description": "A small cross-browser ad blocker (Chrome and Safari, Manifest V3).",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:chrome": "node tools/build.mjs --target=chrome",
    "build:safari": "node tools/build.mjs --target=safari",
    "test": "node --test test/unit.test.mjs",
    "test:e2e": "node test/e2e.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^24.0.0"
  },
  "license": "GPL-3.0-or-later"
}
